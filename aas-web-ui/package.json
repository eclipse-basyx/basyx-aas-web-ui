{
  "name": "aas-web-ui",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "prebuild": "run-s lint:check test:run type-check",
    "build": "vite build",
    "bff:build": "tsc --build tsconfig.bff.json --force",
    "bff:build:watch": "tsc --build tsconfig.bff.json --force --watch --preserveWatchOutput",
    "bff:start": "node dist-bff/edc-bff/server.js",
    "bff:start:proxy": "node --use-env-proxy dist-bff/edc-bff/server.js",
    "bff:start:watch": "node --watch dist-bff/edc-bff/server.js",
    "bff:start:watch:proxy": "node --use-env-proxy --watch dist-bff/edc-bff/server.js",
    "bff:dev": "run-s bff:build && run-p bff:build:watch bff:start:watch",
    "bff:dev:proxy": "run-s bff:build && run-p bff:build:watch bff:start:watch:proxy",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc -b --force",
    "lint": "eslint ./",
    "lint:check": "eslint ./ --max-warnings=0",
    "lint:fix": "eslint --fix",
    "mcp": "ruler apply",
    "mcp:revert": "ruler revert",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:integration": "playwright test --config playwright.config.ts --project=integration-core",
    "test:integration:preview": "IT_TARGET=preview playwright test --config playwright.config.ts --project=integration-core",
    "test:integration:docker": "IT_TARGET=docker playwright test --config playwright.config.ts --project=integration-core",
    "test:integration:feature-control": "IT_DISABLE_WEBSERVER=true playwright test --config playwright.config.ts --project=integration-feature-control",
    "test:integration:timeseries": "IT_DISABLE_WEBSERVER=true playwright test --config playwright.config.ts --project=integration-timeseries",
    "postinstall": "node ./scripts/postinstall.mjs"
  },
  "dependencies": {
    "@aas-core-works/aas-core3.1-typescript": "^1.0.1",
    "@fontsource/roboto": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "@plantuml/core": "1.2026.6",
    "@tanstack/vue-query": "^5.101.4",
    "@thatopen/components": "^3.4.8",
    "@thatopen/components-front": "^3.4.4",
    "@thatopen/fragments": "^3.4.7",
    "@thatopen/ui": "^3.4.10",
    "@thatopen/ui-obc": "^3.4.2",
    "@vue/devtools-api": "^8.2.1",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "aas-package3-typescript": "^1.0.0",
    "apexcharts": "^6.10.0",
    "basyx-typescript-sdk": "^2.2.4",
    "html5-qrcode": "^2.3.8",
    "i18n-iso-countries": "^7.14.0",
    "iso-639-1": "^3.1.6",
    "js-yaml": "^5.3.0",
    "leaflet": "^1.9.4",
    "md5": "^2.3.0",
    "mime": "^4.1.0",
    "pinia": "^4.0.3",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4",
    "three": "^0.185.1",
    "uuid": "^14.0.1",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vue-i18n": "^11.4.8",
    "vue3-apexcharts": "^1.11.1",
    "vuetify": "^4.1.8",
    "web-ifc": "^0.0.77",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@intellectronica/ruler": "^0.3.44",
    "@playwright/test": "^1.62.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/leaflet": "^1.9.22",
    "@types/md5": "^2.3.6",
    "@types/node": "^26.2.0",
    "@types/prismjs": "^1.26.6",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.0",
    "eslint-config-vuetify": "^4.7.2",
    "eslint-plugin-jsdoc": "^64.0.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "pnpm": "11.20.0",
    "sass-embedded": "^1.103.1",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-fonts": "^2.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "engines": {
    "node": ">=24.5.0 <25"
  }
}
