{
  "name": "aas-web-ui",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "prebuild": "run-s lint:check test:run type-check",
    "build": "vite build",
    "bff:build": "tsc --build tsconfig.bff.json --force",
    "bff:build:watch": "tsc --build tsconfig.bff.json --force --watch --preserveWatchOutput",
    "bff:start": "node dist-bff/edc-bff/server.js",
    "bff:start:proxy": "node --use-env-proxy dist-bff/edc-bff/server.js",
    "bff:start:watch": "node --watch dist-bff/edc-bff/server.js",
    "bff:start:watch:proxy": "node --use-env-proxy --watch dist-bff/edc-bff/server.js",
    "bff:dev": "run-s bff:build && run-p bff:build:watch bff:start:watch",
    "bff:dev:proxy": "run-s bff:build && run-p bff:build:watch bff:start:watch:proxy",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc -b --force",
    "lint": "eslint ./",
    "lint:check": "eslint ./ --max-warnings=0",
    "lint:fix": "eslint --fix",
    "mcp": "ruler apply",
    "mcp:revert": "ruler revert",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:integration": "playwright test --config playwright.config.ts --project=integration-core",
    "test:integration:preview": "IT_TARGET=preview playwright test --config playwright.config.ts --project=integration-core",
    "test:integration:docker": "IT_TARGET=docker playwright test --config playwright.config.ts --project=integration-core",
    "test:integration:feature-control": "IT_DISABLE_WEBSERVER=true playwright test --config playwright.config.ts --project=integration-feature-control",
    "test:integration:timeseries": "IT_DISABLE_WEBSERVER=true playwright test --config playwright.config.ts --project=integration-timeseries",
    "postinstall": "node ./scripts/postinstall.mjs"
  },
  "dependencies": {
    "@aas-core-works/aas-core3.1-typescript": "^1.0.1",
    "@fontsource/roboto": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "@plantuml/core": "1.2026.8",
    "@tanstack/vue-query": "^5.107.1",
    "@thatopen/components": "^3.6.0",
    "@thatopen/components-front": "^3.6.1",
    "@thatopen/fragments": "^3.6.1",
    "@thatopen/ui": "^3.4.28",
    "@thatopen/ui-obc": "^3.4.5",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vue/devtools-api": "^8.2.1",
    "aas-package3-typescript": "^1.1.0",
    "ajv": "^8.20.0",
    "apexcharts": "^7.9.1",
    "basyx-typescript-sdk": "^2.4.2",
    "html5-qrcode": "^2.3.8",
    "i18n-iso-countries": "^7.14.0",
    "ical.js": "^2.2.1",
    "iso-639-1": "^3.1.6",
    "js-yaml": "^5.5.0",
    "leaflet": "^1.9.4",
    "md5": "^2.3.0",
    "mime": "^4.1.2",
    "monaco-editor": "^0.56.0",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "three": "^0.185.1",
    "uuid": "^14.0.3",
    "vue": "^3.5.45",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.5.0",
    "vue3-apexcharts": "^1.11.3",
    "vuetify": "^4.3.3",
    "web-ifc": "^0.0.77",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@intellectronica/ruler": "^0.3.46",
    "@playwright/test": "^1.65.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/leaflet": "^1.9.22",
    "@types/md5": "^2.3.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-istanbul": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-vuetify": "^4.7.2",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-vue": "^10.12.1",
    "jsdom": "^30.1.3",
    "json-schema-to-typescript": "16.0.0",
    "npm-run-all2": "^9.0.4",
    "pnpm": "12.19.0",
    "sass-embedded": "^1.108.2",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-fonts": "^2.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.8",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.1.0",
    "vue-tsc": "3.3.11"
  },
  "packageManager": "pnpm@12.19.0+sha512.87327b6619853205834e4be59ba3a231e303d9f5e435912ede3312b7539b79af890942f6513b05a4690745666888045c09b33fc420c2cd2d3bd95c01ba21dbeb",
  "engines": {
    "node": ">=24.5.0 <25"
  }
}
