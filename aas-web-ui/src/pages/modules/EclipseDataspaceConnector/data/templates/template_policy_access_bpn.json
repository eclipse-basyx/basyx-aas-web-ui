{
  "@context": [
    "https://w3id.org/dspace/2025/1/odrl-profile.jsonld",
    "https://w3id.org/catenax/2025/9/policy/context.jsonld",
    {
      "@vocab": "https://w3id.org/edc/v0.0.1/ns/"
    }
  ],
  "@type": "PolicyDefinition",
  "@id": "{{Policy ID|Enter a unique policy identifier|This will be the @id of your policy}}",
  "policy": {
    "@type": "Set",
    "permission": [
      {
        "action": "access",
        "constraint": {
          "leftOperand": "BusinessPartnerNumber",
          "operator": "isAnyOf",
          "rightOperand": [
            "{{BPN|Enter a Business Business Partner Number|The BPN that is allowed to access the data}}"
          ]
        }
      }
    ]
  }
}
